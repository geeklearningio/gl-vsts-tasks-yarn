{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noImplicitAny": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "target": "es2022",
    "lib": ["es2022"],
    "sourceMap": false,
    "inlineSourceMap": true,
    "declaration": true,
    "skipLibCheck": true
  }
}
