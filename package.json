{
  "name": "gl-vsts-tasks-yarn",
  "version": "0.1.0",
  "description": "Yarn task for the Team Services build system (deprecated and unmaintained)",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "clean": "node node_modules/gl-vsts-tasks-build-scripts/dist/clean.js",
    "postinstall": "node node_modules/gl-vsts-tasks-build-scripts/dist/install.js",
    "prepare": "husky || true",
    "prebuild": "node node_modules/gl-vsts-tasks-build-scripts/dist/prebuild.js",
    "build": "tsc",
    "package": "node node_modules/gl-vsts-tasks-build-scripts/dist/package.js",
    "test": "run-s build test:no-build",
    "test:no-build": "node test.js",
    "fix:prettier": "prettier Tasks/**/*.ts --write",
    "lint": "eslint Tasks Tests"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/geeklearningio/gl-vsts-tasks-yarn"
  },
  "keywords": [
    "yarn",
    "node",
    "node.js",
    "npm",
    "npm.js",
    "install"
  ],
  "author": "Geek Learning, Adrien Siffermann, Cyprien Autexier",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/geeklearningio/gl-vsts-tasks-yarn/issues"
  },
  "homepage": "https://github.com/geeklearningio/gl-vsts-tasks-yarn/vsts-tasks",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/ini": "^4.1.1",
    "@types/jasmine": "^5.1.15",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "gl-vsts-tasks-build-scripts": "^0.6.0",
    "husky": "^9.1.7",
    "jasmine": "^5.13.0",
    "jasmine-reporters": "^2.5.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "pretty-quick": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {}
}
